extends Node

# game size
var game_width: float = ProjectSettings.get_setting("display/window/size/viewport_width")
var game_height: float = ProjectSettings.get_setting("display/window/size/viewport_height")
var min_game_size: float = min(game_width, game_height)

# movement
const friction: float = .01
const drift_speed: float = .01

# aesthetic
const true_line_width: float = 1
const default_text_height: float = 12.0
var max_line_width: float = true_line_width * 4
var line_width: float = true_line_width

# planets
var planets: Array = []
var min_planet_radius: float = min_game_size / 15
var max_planet_radius: float = min_game_size / 6

# ball
const init_ball_radius: float = default_text_height / 6
var par: int = 3

## First element in enum is NONE.
enum Element {
	NONE,
	EARTH, FIRE, ENERGY, NATURE,
	AIR, ICE, WATER, MAGIC,
	LOVE, LIGHT, MIGHT, SIGHT
}

